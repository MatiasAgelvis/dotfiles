[Unit]
Description=Blank the console framebuffer at boot
# The kernel blank timer does not fire on this box (kernel 7.0.0-43 + i915drmfb),
# so consoleblank= and setterm never trigger. Writing sysfs works immediately.
After=systemd-vconsole-setup.service
ConditionPathExists=/sys/class/graphics/fb0/blank

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo 4 > /sys/class/graphics/fb0/blank'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
