[Unit]
Description=Homelab off-box backup (restic)
Documentation=https://github.com/MatiasAgelvis/dotfiles/blob/main/docs/backups.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homelab-backup
# restic wants a cache; systemd runs without HOME, so give it an explicit one.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
