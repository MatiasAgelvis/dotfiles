[Unit]
Description=Starisk nightly crawl (residential IP)
Documentation=https://github.com/MatiasAgelvis/starisk/blob/develop/pipeline/starisk/nightly.py
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=matias
WorkingDirectory=/home/matias/src/starisk/pipeline
# mise shims give the pinned python/node from the repo's mise.toml.
Environment=HOME=/home/matias
Environment=PATH=/home/matias/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/matias/src/starisk/.env.prod
ExecStart=/home/matias/.local/share/mise/shims/python -m starisk.nightly
# The runner's contract: 0 = committed, 10 = nothing changed.
SuccessExitStatus=0 10
TimeoutStartSec=3h
Nice=10
