[Unit]
Description=Starisk nightly crawl (containerised, residential IP)
Documentation=https://github.com/MatiasAgelvis/starisk/blob/develop/pipeline/starisk/nightly.py
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Root is required for the Docker socket; the job itself is a one-shot container
# with no ports and its own volume.
ExecStart=/usr/local/bin/starisk-nightly
# 0 = committed, 10 = nothing changed. Anything else is a real failure.
SuccessExitStatus=0 10
TimeoutStartSec=3h
Nice=10
