[user]
	name = Matias Agelvis
	email = magelvisdoz@gmail.com
[core]
	editor = vim
[gitbutler]
	aiOpenAIKeyOption = bringYourOwn
	aiModelProvider = openrouter

# macOS-only bits (Kaleidoscope difftool, Git Credential Manager).
# Stowed separately via the `git-darwin` package; ignored when absent, so this
# is safe on Linux.
[include]
	path = ~/.gitconfig.darwin
