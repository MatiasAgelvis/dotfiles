# Read-only Docker visibility for the admin user. Install with:
#
#   sudo install -m 0440 -o root -g root sudoers/docker-readonly /etc/sudoers.d/docker-readonly
#   sudo visudo -c
#
# `matias` is deliberately NOT in the docker group (root-equivalent). This
# grants metadata-only visibility without a password so everyday checks and
# tooling still work. Anything that mutates state stays password-gated.
#
# Deliberately excluded: `inspect` and `logs` for raw containers. The Coolify
# container used to hold APP_KEY, and with it one could open a root terminal;
# even now, env vars carry secrets. Compose logs are fine, container inspect
# is not.

Cmnd_Alias DOCKER_READ = \
    /usr/bin/docker ps, /usr/bin/docker ps *, \
    /usr/bin/docker images, /usr/bin/docker images *, \
    /usr/bin/docker stats, /usr/bin/docker stats *, \
    /usr/bin/docker volume ls, /usr/bin/docker volume ls *, \
    /usr/bin/docker network ls, /usr/bin/docker network ls *, \
    /usr/bin/docker system df, /usr/bin/docker system df *, \
    /usr/bin/docker version, \
    /usr/bin/docker info, \
    /usr/bin/docker compose ps, /usr/bin/docker compose ps *, \
    /usr/bin/docker compose ls, /usr/bin/docker compose ls *, \
    /usr/bin/docker compose logs, /usr/bin/docker compose logs *, \
    /usr/bin/docker compose config, /usr/bin/docker compose config *, \
    /usr/bin/docker compose -f * ps, /usr/bin/docker compose -f * ps *, \
    /usr/bin/docker compose -f * logs, /usr/bin/docker compose -f * logs *, \
    /usr/bin/docker compose -f * config, /usr/bin/docker compose -f * config *

matias ALL=(root) NOPASSWD: DOCKER_READ
